# Public site origin without a trailing slash, e.g. https://example.in. Used for canonical URLs, the sitemap and the share image. Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key. Leave empty to ship the WhatsApp / email fallback (the form then sends nothing to Web3Forms).
NEXT_PUBLIC_WEB3FORMS_KEY=
